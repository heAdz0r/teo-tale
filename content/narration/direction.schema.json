{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Narration direction",
  "type": "object",
  "required": ["version", "model", "defaultVoice", "voices", "defaults", "pronunciations", "chapters"],
  "properties": {
    "version": { "const": 1 },
    "model": { "const": "v5_5_ru" },
    "defaultVoice": { "type": "string" },
    "voices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "description"],
        "properties": {
          "id": { "enum": ["aidar", "baya", "kseniya", "xenia", "eugene"] },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "defaults": {
      "type": "object",
      "required": ["maxChars", "paragraphPauseMs", "scenePauseMs"],
      "properties": {
        "maxChars": { "type": "integer", "minimum": 100, "maximum": 1000 },
        "paragraphPauseMs": { "type": "integer", "minimum": 0, "maximum": 3000 },
        "scenePauseMs": { "type": "integer", "minimum": 0, "maximum": 5000 }
      },
      "additionalProperties": false
    },
    "pronunciations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["word", "say"],
        "properties": {
          "word": { "type": "string", "minLength": 1 },
          "say": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "chapters": {
      "type": "object",
      "patternProperties": {
        "^chapter-[1-9][0-9]*$": {
          "type": "object",
          "required": ["cues"],
          "properties": {
            "cues": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["anchor"],
                "properties": {
                  "anchor": { "type": "string", "minLength": 1 },
                  "say": { "type": "string", "minLength": 1 },
                  "rate": { "enum": ["x-slow", "slow", "medium", "fast", "x-fast"] },
                  "pitch": { "enum": ["x-low", "low", "medium", "high", "x-high"] },
                  "beforeMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
                  "afterMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
                  "note": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

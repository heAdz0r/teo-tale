  "chapters": {
    "chapter-1": { "cues": [
      { "anchor": "В деревне, где жил Тео, было восемь домов, одна школа и одна большая дорога.", "rate": "slow", "afterMs": 420, "note": "Спокойный сказовый зачин" },
      { "anchor": "Он поднял голову.", "beforeMs": 260, "afterMs": 620, "rate": "slow", "pitch": "low", "note": "Пауза перед первым появлением замка" },
      { "anchor": "А это уже была задача.", "beforeMs": 250, "afterMs": 720, "rate": "slow", "pitch": "low", "note": "Финальная мысль сцены" }
    ] },
    "chapter-2": { "cues": [
      { "anchor": "Прошёл месяц, и Тео почти поверил, что всё это ему приснилось.", "rate": "slow", "afterMs": 420, "note": "Зачин новой главы" }
    ] },
    "chapter-3": { "cues": [
      { "anchor": "Развилку Тео увидел издалека, потому что она горела.", "rate": "slow", "afterMs": 450, "pitch": "low", "note": "Тревожное открытие" }
    ] },
    "chapter-4": { "cues": [
      { "anchor": "Тео проснулся среди ночи от того, что внизу упала скамейка.", "rate": "slow", "afterMs": 380, "pitch": "low", "note": "Ночная сцена" }
    ] },
    "chapter-5": { "cues": [
      { "anchor": "Приём кончился нескоро.", "rate": "slow", "afterMs": 520, "note": "Смена темпа после приёма" }
    ] },
    "chapter-6": { "cues": [
      { "anchor": "Тео ещё долго смотрел на принца и никак не мог соединить в голове два его лица.", "rate": "slow", "afterMs": 430, "note": "Осмысление открытия" }
    ] },
    "chapter-7": { "cues": [
      { "anchor": "Тео стоял среди первых деревьев Сумеречного леса и пытался вспомнить цвет плаща Талоса.", "rate": "slow", "afterMs": 430, "pitch": "low", "note": "Лес должен прозвучать настороженно" }
    ] },
    "chapter-8": { "cues": [
      { "anchor": "Медная печать Талоса лежала на ладони Тео и становилась всё холоднее.", "rate": "slow", "afterMs": 450, "pitch": "low", "note": "Холод и нарастающая угроза" }
    ] },
    "chapter-9": { "cues": [
      { "anchor": "Щелчок под полом прозвучал негромко.", "rate": "slow", "afterMs": 620, "pitch": "low", "note": "Дать читателю услышать щелчок" }
    ] },
    "chapter-10": { "cues": [
      { "anchor": "Талос стоял по ту сторону зеркала и молчал.", "rate": "slow", "afterMs": 520, "pitch": "low", "note": "Напряжённое молчание" }
    ] },
    "chapter-11": { "cues": [
      { "anchor": "Совет собирали в комнате, где не было ни одного зеркала.", "rate": "slow", "afterMs": 430, "pitch": "low", "note": "Подчеркнуть отсутствие зеркал" }
    ] },
    "chapter-12": { "cues": [
      { "anchor": "До часовой башни вели триста шестнадцать ступеней.", "rate": "slow", "afterMs": 430, "note": "Размеренный подъём" }
    ] },
    "chapter-13": { "cues": [
      { "anchor": "Первое заседание совета без кольца длилось от завтрака до самого обеда, и Тео успел выучить наизусть трещину на потолке.", "rate": "slow", "afterMs": 360, "note": "Суховатый сказовый юмор" }
    ] },
    "chapter-14": { "cues": [
      { "anchor": "— Не запустите?", "rate": "slow", "afterMs": 480, "pitch": "low", "note": "Вопрос из тишины" }
    ] },
    "chapter-15": { "cues": [
      { "anchor": "Уходили на рассвете, и провожала их вся долина.", "rate": "slow", "afterMs": 460, "note": "Широкий дорожный зачин" }
    ] },
    "chapter-16": { "cues": [
      { "anchor": "Обратная дорога заняла четыре дня, и это было чудо, потому что пешком выходило двенадцать.", "rate": "slow", "afterMs": 420, "note": "Возвращение" }
    ] },
    "chapter-17": { "cues": [
      { "anchor": "Северин остановился у первого дома и закрыл книгу.", "rate": "slow", "afterMs": 520, "pitch": "low", "note": "Остановка перед развязкой" }
    ] },
    "chapter-18": { "cues": [
      { "anchor": "Крестовину от пугала подняли на холм в темноте, потому что днём ветер был слабее.", "rate": "slow", "afterMs": 460, "note": "Тихий финальный зачин" }
    ] }
